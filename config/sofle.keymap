#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define GAME 3

&led_strip {
    chain-length = <36>;
};

&nice_view_spi {
    cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;
};

/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
                // ------------------------------------------------------------------------------------------------------------
                // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
                // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
                // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
                // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   |   =   |

                //               | CTRL | ALT | GUI | LOWER | SPACE | | BSPC | RAISE | RCTRL | LALT | RSHIFT |
            bindings = <
                &kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp BSPC
                &kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp LBKT
                &kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
                &kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &kp C_PP      &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp EQUAL
                                &kp LCTRL &kp LALT &kp LGUI &mo LOWER  &kp SPACE    &kp BSPC  &mo RAISE  &kp RCTRL &kp LALT  &kp RSHFT
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp C_NEXT C_PREV
                >;
        };

        lower_layer {
            display-name = "lower";
            // Transparent positions inherit from BASE.
            // Left / right halves; encoder clicks are between the bottom rows.
            // | GAME| F1   | F2   | F3    | F4 | F5 |   | F6 | F7 | F8 | F9 | F10 | F11 |
            // |  v  | HOME | UP   | END   | v  | v  |   | v  | v  | v  | v  | v   | F12 |
            // |  v  | LEFT | DOWN | RIGHT | v  | v  |   | v  | v  | v  | v  | v   | v   |
            // Thumb positions 54 / 55 are Delete / Enter; other remaining positions are transparent.
            bindings = <
                &to GAME    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                    &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
                &trans &kp HOME    &kp UP    &kp END      &trans    &trans                    &trans    &trans   &trans    &trans    &trans    &kp F12
                &trans    &kp LEFT  &kp DOWN    &kp RIGHT    &trans  &trans                 &trans &trans &trans &trans  &trans  &trans
                &trans    &trans &trans &trans &trans  &trans   &trans &trans  &trans  &trans &trans  &trans &trans  &trans
                                    &trans    &trans      &trans    &trans     &kp DEL &kp RET  &trans    &trans   &trans    &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp C_NEXT C_PREV
            >;
        };

        raise_layer {
            display-name = "raise";
            // Transparent positions inherit from BASE.
            // | BTCLR | BT1 | BT2 | BT3 | BT4 | BT5 |   | F6   | F7   | F8   | F9    | F10 | F11 |
            // | v     | v   | v   | v   | v   | v   |   | PGUP | HOME | UP   | END   | v   | v   |
            // | v     | v   | v   | v   | v   | v   |   | PGDN | LEFT | DOWN | RIGHT | v   | v   |
            // Thumb positions 54 / 55 are Delete / Enter; other remaining positions are transparent.
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &kp F6    &kp F7    &kp F8   &kp F9    &kp F10  &kp F11
                &trans     &trans      &trans    &trans  &trans       &trans                        &kp PG_UP &kp HOME    &kp UP   &kp END    &trans  &trans
                &trans     &trans     &trans    &trans    &trans       &trans                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &trans &trans
                &trans     &trans   &trans    &trans   &trans  &trans        &trans  &trans  &trans    &trans    &trans   &trans    &trans  &trans
                                        &trans       &trans       &trans       &trans        &kp DEL  &kp RET  &trans    &trans    &trans   &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp C_NEXT C_PREV
            >;
        };


        gaming_layer {
            display-name = "gaming";
            // LOWER + top-left enters GAME. Top-left or top-right returns to BASE.
            bindings = <
                &to BASE &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &trans &trans &trans &trans &trans &to BASE
                &none &kp TAB &kp Q &kp W &kp E &kp R &trans &trans &trans &trans &trans &trans
                &none &kp LSHFT &kp A &kp S &kp D &kp F &trans &trans &trans &trans &trans &trans
                &none &kp LCTRL &kp Z &kp X &kp C &kp V &trans &trans &trans &trans &trans &trans &trans &trans
                &none &kp G &kp B &kp N5 &kp SPACE &trans &none &trans &trans &none
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_NEXT C_PREV
            >;
        };

    };
};
